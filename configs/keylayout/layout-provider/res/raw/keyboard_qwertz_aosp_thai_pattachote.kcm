#
# Thai Pattachote keyboard layout.
#


# Compact BlackBerry adaptation; Copyright (C) 2015 BlackBerry Limited (baseline).
# Language modifiers/currency and physical family are retained.

type OVERLAY


key Q {
    base: '\u0e47'
    shift: '\u0e4a'
    capslock: '\u0e4a'
    label: 'Q'
    number: '#'
    alt: '#'
    lalt: '#'
    sym: '~'
}

key W {
    base: '\u0e15'
    shift: '\u0e24'
    capslock: '\u0e24'
    label: 'W'
    number: '1'
    alt: '1'
    lalt: '1'
    sym: '`'
}

key E {
    base: '\u0e22'
    shift: '\u0e46'
    capslock: '\u0e46'
    label: 'E'
    number: '2'
    alt: '2'
    lalt: '2'
    sym: '{'
}

key R {
    base: '\u0e2d'
    shift: '\u0e0d'
    capslock: '\u0e0d'
    label: 'R'
    number: '3'
    alt: '3'
    lalt: '3'
    sym: '}'
}

key T {
    base: '\u0e23'
    shift: '\u0e29'
    capslock: '\u0e29'
    label: 'T'
    number: '('
    alt: '('
    lalt: '('
    sym: '['
}

key Z {
    base: '\u0e1a'
    shift: '\u0e0e'
    capslock: '\u0e0e'
    label: 'Z'
    number: ')'
    alt: ')'
    lalt: ')'
    sym: '\u005d'
}

key U {
    base: '\u0e14'
    shift: '\u0e1d'
    capslock: '\u0e1d'
    label: 'U'
    number: none
    alt: '_'
    lalt: '_'
    sym: '<'
}

key I {
    base: '\u0e21'
    shift: '\u0e0b'
    capslock: '\u0e0b'
    label: 'I'
    number: '-'
    alt: '-'
    lalt: '-'
    sym: '>'
}

key O {
    base: '\u0e27'
    shift: '\u0e16'
    capslock: '\u0e16'
    label: 'O'
    number: '+'
    alt: '+'
    lalt: '+'
    sym: '^'
}

key P {
    base: '\u0e41'
    shift: '\u0e12'
    capslock: '\u0e12'
    label: 'P'
    number: none
    alt: '@'
    lalt: '@'
    sym: '%'
}

key A {
    base: '\u0e49'
    shift: '\u0e4b'
    capslock: '\u0e4b'
    label: 'A'
    number: '*'
    alt: '*'
    lalt: '*'
    sym: '='
}

key S {
    base: '\u0e17'
    shift: '\u0e18'
    capslock: '\u0e18'
    label: 'S'
    number: '4'
    alt: '4'
    lalt: '4'
    sym: '\u00F7'
}

key D {
    base: '\u0e07'
    shift: '\u0e33'
    capslock: '\u0e33'
    label: 'D'
    number: '5'
    alt: '5'
    lalt: '5'
