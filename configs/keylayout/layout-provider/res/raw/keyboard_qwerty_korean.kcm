#
# Blackberry Korean Physical Keyboard
#

type OVERLAY

### ROW 1

key Q {
    label:                              'Q'
    base:                               '\u3142'
    shift, capslock:                    '\u3143'
    alt, lalt:                          '#'
    sym:                                '~'
}

key W {
    label:                              'W'
    base:                               '\u3148'
    shift, capslock:                    '\u3149'
    alt, lalt:                          '1'
    sym:                                '`'
}

key E {
    label:                              'E'
    base:                               '\u3137'
    shift, capslock:                    '\u3138'
    alt, lalt:                          '2'
    sym:                                '{'
}

key R {
    label:                              'R'
    base:                               '\u3131'
    shift, capslock:                    '\u3132'
    alt, lalt:                          '3'
    sym:                                '}'
}

key T {
    label:                              'T'
    base:                               '\u3145'
    shift, capslock:                    '\u3146'
    alt, lalt:                          '('
    sym:                                '['
}

key Y {
    label:                              'Y'
    base:                               '\u315b'
    shift, capslock:                    '\u315b'
    alt, lalt:                          ')'
    sym:                                ']'
}

key U {
    label:                              'U'
    base:                               '\u3155'
    shift, capslock:                    '\u3155'
    alt, lalt:                          '_'
    sym:                                '<'
}

key I {
    label:                              'I'
    base:                               '\u3151'
    shift, capslock:                    '\u3151'
    alt, lalt:                          '-'
    sym:                                '>'
}

key O {
    label:                              'O'
    base:                               '\u3150'
    shift, capslock:                    '\u3152'
    alt, lalt:                          '+'
    sym:                                '^'
}

key P {
    label:                              'P'
    base:                               '\u3154'
    shift, capslock:                    '\u3156'
    alt, lalt:                          '@'
    sym:                                '%'
}

### ROW 2

key A {
    label:                              'A'
    base:                               '\u3141'
    shift, capslock:                    '\u3141'
    alt, lalt:                          '*'
    sym:                                '='
}

key S {
    label:                              'S'
    base:                               '\u3134'
    shift, capslock:                    '\u3134'
    alt, lalt:                          '4'
    sym:                                '\u00F7'
}

key D {
    label:                              'D'
    base:                               '\u3147'
    shift, capslock:                    '\u3147'
    alt, lalt:                          '5'
    sym:                                '\u00B1'
}

key F {
    label:                              'F'
    base:                               '\u3139'
    shift, capslock:                    '\u3139'
    alt, lalt:                          '6'
    sym:                                '\u2022'
}

key G {
    label:                              'G'
    base:                               '\u314E'
    shift, capslock:                    '\u314E'
    alt, lalt:                          '/'
    sym:                                '\\'
}

key H {
    label:                              'H'
    base:                               '\u3157'
    shift, capslock:                    '\u3157'
    alt, lalt:                          ':'
    sym:                                '|'
}

key J {
    label:                              'J'
    base:                               '\u3153'
    shift, capslock:                    '\u3153'
    alt, lalt:                          ';'
    sym:                                '&'
}

key K {
    label:                              'K'
    base:                               '\u314F'
    shift, capslock:                    '\u314F'
    alt, lalt:                          '\''
    sym:                                '\u201C'
}

key L {
    label:                              'L'
    base:                               '\u3163'
    shift, capslock:                    '\u3163'
    alt, lalt:                          '\"'
    sym:                                '\u201D'
}

### ROW 3

key Z {
    label:                              'Z'
    base:                               '\u314B'
    shift, capslock:                    '\u314B'
    alt, lalt:                          '7'
    sym:                                '\u00A5'
}

key X {
    label:                              'X'
    base:                               '\u314C'
    shift, capslock:                    '\u314C'
    alt, lalt:                          '8'
    sym:                                '\u20AC'
}

key C {
    label:                              'C'
    base:                               '\u314A'
    shift, capslock:                    '\u314A'
    alt, lalt:                          '9'
    sym:                                '\u00A3'
}

key V {
    label:                              'V'
    base:                               '\u314D'
    shift, capslock:                    '\u314D'
    alt, lalt:                          '?'
    sym:                                '\u00BF'
}

key B {
    label:                              'B'
    base:                               '\u3160'
    shift, capslock:                    '\u3160'
    alt, lalt:                          '!'
    sym:                                '\u00A1'
}

key N {
    label:                              'N'
    base:                               '\u315C'
    shift, capslock:                    '\u315C'
    alt, lalt:                          ','
    sym:                                '\u00AB'
}

key M {
    label:                              'M'
    base:                               '\u3161'
    shift, capslock:                    '\u3161'
    alt, lalt:                          '.'
    sym:                                '\u00BB'
}

key 4 {
    label:                              '$'
    base:                               '\u20A9'
    shift, capslock:                    '\u20A9'
    alt, lalt:                          '\u20A9'
    sym:                                '$'
    lalt+lshift:                        '\uE141' # Special character means this is speaker key
}
