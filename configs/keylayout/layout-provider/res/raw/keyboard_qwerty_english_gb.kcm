#
# Blackberry Qwerty Physical Keyboard
#

type OVERLAY

key 4 {
    label:                              '\u00A3' # Pound Sterling
    base, capslock:                     '\u00A3' # Pound Sterling
    shift:                              '\u20AC' # Euro
    alt, lalt:                          '$'
    sym:                                '$'
    lalt+lshift:                        '\uE141' # Special character means this is speaker key
}
