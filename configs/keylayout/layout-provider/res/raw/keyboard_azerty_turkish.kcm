#
# BlackBerry Turkish keyboard layout.
#

type OVERLAY

### ROW 1

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    alt, lalt:                          '#'
    sym:                                '~'
}

key Z {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
    alt, lalt:                          '1'
    sym:                                '`'
}

key I {
    label:                              'I'
    base:                               '\u0131'
    shift, capslock:                    'I'
    alt, lalt:                          '-'
    sym:                                '>'
}

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    alt, lalt:                          '*'
    sym:                                '='
}

key W {
    label:                              'W'
    base:                               'w'
    shift, capslock:                    'W'
    alt, lalt:                          '7'
    sym:                                '\u00A5'
}

key 4 {
    label:                              '$'
    base, capslock:                     '\u20BA' # Turkish Lira
    shift:                              '\u20AC' # Euro
    alt, lalt:                          '$'
    sym:                                '$'
    lalt+lshift:                        '\uE141' # Special character means this is speaker key
}
