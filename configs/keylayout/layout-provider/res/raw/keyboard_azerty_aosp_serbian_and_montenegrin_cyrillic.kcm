    capslock+shift: '\u043b'
    shift: '\u041b'
    capslock: '\u041b'
    label: 'L'
    number: none
    alt: '\"'
    lalt: '\"'
    sym: '\u201D'
}

key W {
    base: '\u045a'
    capslock+shift: '\u045a'
    shift: '\u040a'
    capslock: '\u040a'
    label: 'W'
    number: '7'
    alt: '7'
    lalt: '7'
    sym: '\u00a5'
}

key X {
    base: '\u045f'
    capslock+shift: '\u045f'
    shift: '\u040f'
    capslock: '\u040f'
    label: 'X'
    number: '8'
    alt: '8'
    lalt: '8'
    sym: '\u20AC'
}

key C {
    base: '\u0446'
    capslock+shift: '\u0446'
    shift: '\u0426'
    capslock: '\u0426'
    label: 'C'
    number: '9'
    alt: '9'
    lalt: '9'
    sym: '\u00A3'
}

key V {
    base: '\u0432'
    capslock+shift: '\u0432'
    shift: '\u0412'
    capslock: '\u0412'
    label: 'V'
    number: none
    alt: '?'
    lalt: '?'
    sym: '\u00BF'
}

key B {
    base: '\u0431'
    capslock+shift: '\u0431'
    shift: '\u0411'
    capslock: '\u0411'
    label: 'B'
    number: none
    alt: '!'
    lalt: '!'
    sym: '\u00A1'
}

key N {
    base: '\u043d'
    capslock+shift: '\u043d'
    shift: '\u041d'
