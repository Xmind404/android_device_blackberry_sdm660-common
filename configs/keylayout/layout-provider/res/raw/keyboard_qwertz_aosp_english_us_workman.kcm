#
# English (US), Workman keyboard layout.
# Unlike the default (generic) keyboard layout, English (US) does not contain any
# special ALT characters.
#


# Compact BlackBerry adaptation; Copyright (C) 2015 BlackBerry Limited (baseline).
# Language modifiers/currency and physical family are retained.

type OVERLAY

map key 16 Q
map key 17 D
map key 18 R
map key 19 W
map key 20 B
map key 21 J
map key 22 F
map key 23 U
map key 24 P
map key 25 I
map key 30 A
map key 31 S
map key 32 H
map key 33 T
map key 34 G
map key 35 Y
map key 36 N
map key 37 E
map key 38 O
map key 44 Z
map key 45 X
map key 46 M
map key 47 C
map key 48 V
map key 49 K
map key 50 L

key Z {
    base: 'z'
    shift: 'Z'
    capslock: 'Z'
    shift+capslock: 'z'
    label: 'Z'
    number: '7'
    alt: '7'
    lalt: '7'
    sym: '\u00A5'
}

key Y {
    base: 'y'
    shift: 'Y'
    capslock: 'Y'
    shift+capslock: 'y'
    label: 'Y'
    number: ':'
    alt: ':'
    lalt: ':'
    sym: '|'
}

key 4 {
    label: '$'
    base: '$'
    capslock: '$'
    shift: '\u20AC'
    alt: '$'
    lalt: '$'
    sym: '$'
    lalt+lshift: '\uE141'
}

key Q {
    base: 'q'
    shift: 'Q'
    capslock: 'Q'
    shift+capslock: 'q'
    label: 'Q'
    number: '#'
    alt: '#'
    lalt: '#'
    sym: '~'
}

key D {
    base: 'd'
    shift: 'D'
    capslock: 'D'
    shift+capslock: 'd'
    label: 'D'
    number: '1'
    alt: '1'
    lalt: '1'
    sym: '`'
}

key R {
    base: 'r'
    shift: 'R'
    capslock: 'R'
    shift+capslock: 'r'
    label: 'R'
    number: '2'
    alt: '2'
    lalt: '2'
    sym: '{'
}

key W {
    base: 'w'
    shift: 'W'
    capslock: 'W'
    shift+capslock: 'w'
    label: 'W'
    number: '3'
    alt: '3'
    lalt: '3'
    sym: '}'
}

key B {
    base: 'b'
    shift: 'B'
    capslock: 'B'
    shift+capslock: 'b'
    label: 'B'
    number: '('
    alt: '('
    lalt: '('
    sym: '['
}

key J {
    base: 'j'
    shift: 'J'
    capslock: 'J'
    shift+capslock: 'j'
    label: 'J'
    number: ')'
    alt: ')'
    lalt: ')'
    sym: ']'
}

key F {
    base: 'f'
    shift: 'F'
    capslock: 'F'
    shift+capslock: 'f'
    label: 'F'
    number: none
    alt: '_'
    lalt: '_'
    sym: '<'
}

key U {
    base: 'u'
    shift: 'U'
    capslock: 'U'
    shift+capslock: 'u'
    label: 'U'
    number: '-'
    alt: '-'
    lalt: '-'
    sym: '>'
}

key P {
    base: 'p'
    shift: 'P'
    capslock: 'P'
    shift+capslock: 'p'
    label: 'P'
    number: '+'
    alt: '+'
    lalt: '+'
    sym: '^'
}

key I {
    base: 'i'
    shift: 'I'
    capslock: 'I'
    shift+capslock: 'i'
    label: 'I'
    number: none
    alt: '@'
    lalt: '@'
    sym: '%'
}

key A {
    base: 'a'
    shift: 'A'
    capslock: 'A'
    shift+capslock: 'a'
    label: 'A'
    number: '*'
    alt: '*'
    lalt: '*'
    sym: '='
}

key S {
    base: 's'
    shift: 'S'
    capslock: 'S'
    shift+capslock: 's'
    label: 'S'
    number: '4'
    alt: '4'
    lalt: '4'
    sym: '\u00F7'
}

key H {
    base: 'h'
    shift: 'H'
    capslock: 'H'
    shift+capslock: 'h'
    label: 'H'
    number: '5'
    alt: '5'
    lalt: '5'
    sym: '\u00B1'
}

key T {
    base: 't'
    shift: 'T'
    capslock: 'T'
    shift+capslock: 't'
    label: 'T'
    number: '6'
    alt: '6'
    lalt: '6'
    sym: '\u2022'
}

key G {
    base: 'g'
    shift: 'G'
    capslock: 'G'
    shift+capslock: 'g'
    label: 'G'
    number: '/'
    alt: '/'
    lalt: '/'
    sym: '\\'
}

key N {
    base: 'n'
    shift: 'N'
    capslock: 'N'
    shift+capslock: 'n'
    label: 'N'
    number: ';'
    alt: ';'
    lalt: ';'
    sym: '&'
}

key E {
    base: 'e'
    shift: 'E'
    capslock: 'E'
    shift+capslock: 'e'
    label: 'E'
    number: '\''
    alt: '\''
    lalt: '\''
    sym: '\u201C'
}

key O {
    base: 'o'
    shift: 'O'
    label: 'O'
    number: none
    alt: '\"'
    lalt: '\"'
    sym: '\u201D'
}

key X {
    base: 'x'
    shift: 'X'
    capslock: 'X'
    shift+capslock: 'x'
    label: 'X'
    number: '8'
    alt: '8'
    lalt: '8'
    sym: '\u20AC'
}

key M {
    base: 'm'
    shift: 'M'
    capslock: 'M'
    shift+capslock: 'm'
    label: 'M'
    number: '9'
    alt: '9'
    lalt: '9'
    sym: '\u00A3'
}

key C {
    base: 'c'
    shift: 'C'
    capslock: 'C'
    shift+capslock: 'c'
    label: 'C'
    number: none
    alt: '?'
    lalt: '?'
    sym: '\u00BF'
}

key V {
    base: 'v'
    shift: 'V'
    capslock: 'V'
    shift+capslock: 'v'
    label: 'V'
    number: none
    alt: '!'
    lalt: '!'
    sym: '\u00A1'
}

key K {
    base: 'k'
    shift: 'K'
    capslock: 'K'
    shift+capslock: 'k'
    label: 'K'
    number: ','
    alt: ','
    lalt: ','
    sym: '\u00AB'
}

key L {
    base: 'l'
    shift: 'L'
    capslock: 'L'
    shift+capslock: 'l'
    label: 'L'
    number: '.'
    alt: '.'
    lalt: '.'
    sym: '\u00BB'
}
