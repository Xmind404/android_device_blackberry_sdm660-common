#
# Blackberry Qwertz Physical Keyboard
#

type OVERLAY

key Z {
    label:                              'Z'
    base:                               'z'
    shift, capslock:                    'Z'
    lalt:                               ')'
    sym:                                ']'
}

key I {
    label:                              'I'
    base:                               '\u0131'
    shift, capslock:                    'I'
    lalt:                               '-'
    sym:                                '>'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    lalt:                               '7'
    sym:                                '\u00A5'
}

key 4 {
    label:                              '$'
    base, capslock:                     '\u20BA' # Turkish Lira
    shift:                              '\u20AC' # Euro
    alt, lalt:                          '$'
    sym:                                '$'
    lalt+lshift:                        '\uE141' # Special character means this is speaker key
}
