#
# Blackberry Chinese Pinyin Physical Keyboard
#

type OVERLAY

key GRAVE {
    label:                              '\u0401'
    base:                               '\u0451'
    shift, capslock:                    '\u0401'
    ralt:                               '`'
    ralt+shift:                         '~'
    lalt+lshift:                        '\uef20' # Special character means this is multi-tap map
}

### ROW 1

key Q {
    label:                              'Q'
    number:                             '#'      # HALFWIDTH NUMBER SIGN
    base:                               'q'
    shift, capslock:                    'Q'
    alt, lalt:                          '\uff03' # FULLWIDTH NUMBER SIGN
    sym:                                '~'
}

key W {
    label:                              'W'
    number:                             '1'
    base:                               'w'
    shift, capslock:                    'W'
    alt, lalt:                          '1'
    sym:                                '`'
}

key E {
    label:                              'E'
    number:                             '2'
    base:                               'e'
    shift, capslock:                    'E'
    alt, lalt:                          '2'
    sym:                                '{'
}

key R {
    label:                              'R'
    number:                             '3'
    base:                               'r'
    shift, capslock:                    'R'
    alt, lalt:                          '3'
    sym:                                '}'
}

key T {
    label:                              'T'
    number:                             '('      # HALFWIDTH LEFT PARENTHESIS
    base:                               't'
    shift, capslock:                    'T'
    alt, lalt:                          '\uff08' # FULLWIDTH LEFT PARENTHESIS
    sym:                                '['
}


key Z {
    label:                              'Z'
    number:                             ')'      # HALFWIDTH RIGHT PARENTHESIS
    base:                               'z'
    shift, capslock:                    'Z'
    alt, lalt:                          '\uff09' # FULLWIDTH RIGHT PARENTHESIS
    sym:                                ']'
}

key U {
    label:                              'U'
    number:                             '_'      # HALFWIDTH LOW LINE
    base:                               'u'
    shift, capslock:                    'U'
    alt, lalt:                          '\uff3f' # FULLWIDTH LOW LINE
    sym:                                '<'
}

key I {
    label:                              'I'
    number:                             '-'      # HALFWIDTH HYPHEN-MINUS
    base:                               'i'
    shift, capslock:                    'I'
    alt, lalt:                          '\uff0d' # FULLWIDTH HYPHEN-MINUS
    sym:                                '>'
}

key O {
    label:                              'O'
    number:                             '+'      # HALFWIDTH PLUS SIGN
    base:                               'o'
    shift, capslock:                    'O'
    alt, lalt:                          '\uff0b' # FULLWIDTH PLUS SIGN
    sym:                                '^'
}

key P {
    label:                              'P'
    number:                             '@'
    base:                               'p'
    shift, capslock:                    'P'
    alt, lalt:                          '@'
    sym:                                '%'
}

### ROW 2

key A {
    label:                              'A'
    number:                             '*'      # HALFWIDTH ASTERISK
    base:                               'a'
    shift, capslock:                    'A'
    alt, lalt:                          '\uff0a' # FULLWIDTH ASTERISK
    sym:                                '='
}

key S {
    label:                              'S'
    number:                             '4'
    base:                               's'
    shift, capslock:                    'S'
    alt, lalt:                          '4'
    sym:                                '\u00f7'
}

key D {
    label:                              'D'
    number:                             '5'
    base:                               'd'
    shift, capslock:                    'D'
    alt, lalt:                          '5'
    sym:                                '\u00b1'
}

key F {
    label:                              'F'
    number:                             '6'
    base:                               'f'
    shift, capslock:                    'F'
    alt, lalt:                          '6'
    sym:                                '\u2022'
}

key G {
    label:                              'G'
    number:                             '/'      # HALFWIDTH SOLIDUS
    base:                               'g'
    shift, capslock:                    'G'
    alt, lalt:                          '\uff0f' # FULLWIDTH SOLIDUS
    sym:                                '\\'
}

key H {
    label:                              'H'
    number:                             ':'      # HALFWIDTH COLON
    base:                               'h'
    shift, capslock:                    'H'
    alt, lalt:                          '\uff1a' # FULLWIDTH COLON
    sym:                                '|'
}

key J {
    label:                              'J'
    number:                             ';'      # HALFWIDTH SEMICOLON
    base:                               'j'
    shift, capslock:                    'J'
    alt, lalt:                          '\uff1b' # FULLWIDTH SEMICOLON
    sym:                                '&'
}

key K {
    label:                              'K'
    number:                             '\''     # HALFWIDTH APOSTROPHE
    base:                               'k'
    shift, capslock:                    'K'
    alt, lalt:                          '\uff07' # FULLWIDTH APOSTROPHE
    sym:                                '\u201c'
}

key L {
    label:                              'L'
    number:                             '"'      # HALFWIDTH QUOTATION MARK
    base:                               'l'
    shift, capslock:                    'L'
    alt, lalt:                          '\uff02' # FULLWIDTH QUOTATION MARK
    sym:                                '\u201d'
}

### ROW 3

key Y {
    label:                              'Y'
    number:                             '7'
    base:                               'y'
    shift, capslock:                    'Y'
    alt, lalt:                          '7'
    sym:                                '\u00a5'
}

key X {
    label:                              'X'
    number:                             '8'
    base:                               'x'
    shift, capslock:                    'X'
    alt, lalt:                          '8'
    sym:                                '\u20ac'
}

key C {
    label:                              'C'
    number:                             '9'
    base:                               'c'
    shift, capslock:                    'C'
    alt, lalt:                          '9'
    sym:                                '\u00a3'
}

key V {
    label:                              'V'
    number:                             '?'      # HALFWIDTH QUESTION MARK
    base:                               'v'
    shift, capslock:                    'V'
    alt, lalt:                          '\uff1f' # FULLWIDTH QUESTION MARK
    sym:                                '\u00bf'
}

key B {
    label:                              'B'
    number:                             '!'      # HALFWIDTH EXCLAMATION MARK
    base:                               'b'
    shift, capslock:                    'B'
    alt, lalt:                          '\uff01' # FULLWIDTH EXCLAMATION MARK
    sym:                                '\u00a1'
}

key N {
    label:                              'N'
    number:                             ','      # HALFWIDTH COMMA
    base:                               'n'
    shift, capslock:                    'N'
    alt, lalt:                          '\uff0c' # FULLWIDTH COMMA
    sym:                                '\u00ab'
}

key M {
    label:                              'M'
    number:                             '.'      # HALFWIDTH STOP
    base:                               'm'
    shift, capslock:                    'M'
    alt, lalt:                          '\u3002' # IDEOGRAPHIC FULL STOP
    sym:                                '\u00bb'
}

key 4 {
    label:                              '$'
    number:                             '$'
    base:                               '\uffe5' # FULLWIDTH YEN SIGN
    shift, capslock:                    '\uffe5'
    alt, lalt:                          '\uffe5'
    sym:                                '$'
    lalt+lshift:                        '\ue141' # Special character means this is speaker key
}