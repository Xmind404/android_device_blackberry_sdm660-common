#
# Serbian and Montenegrin (Cyrillic) keyboard layout.
#


# Compact BlackBerry adaptation; Copyright (C) 2015 BlackBerry Limited (baseline).
# Language modifiers/currency and physical family are retained.

type OVERLAY


key A {
    base: '\u0430'
    capslock+shift: '\u0430'
    shift: '\u0410'
    capslock: '\u0410'
    label: 'A'
    number: '#'
    alt: '#'
    lalt: '#'
    sym: '\u007e'
}

key Z {
    base: '\u0455'
    capslock+shift: '\u0455'
    shift: '\u0405'
    capslock: '\u0405'
    label: 'Z'
    number: '1'
    alt: '1'
    lalt: '1'
    sym: '\u0060'
}

key E {
    base: '\u0435'
    capslock+shift: '\u0435'
    shift: '\u0415'
    capslock: '\u0415'
    label: 'E'
    number: '2'
    alt: '2'
    lalt: '2'
    sym: '{'
}

key R {
    base: '\u0440'
    capslock+shift: '\u0440'
    shift: '\u0420'
    capslock: '\u0420'
    label: 'R'
    number: '3'
    alt: '3'
    lalt: '3'
    sym: '}'
}

key T {
    base: '\u0442'
    capslock+shift: '\u0442'
    shift: '\u0422'
    capslock: '\u0422'
    label: 'T'
    number: '('
    alt: '('
    lalt: '('
    sym: '['
}

key Y {
    base: '\u0437'
    capslock+shift: '\u0437'
    shift: '\u0417'
    capslock: '\u0417'
    label: 'Y'
    number: ')'
    alt: ')'
    lalt: ')'
    sym: ']'
}

key U {
    base: '\u0443'
    capslock+shift: '\u0443'
    shift: '\u0423'
    capslock: '\u0423'
    label: 'U'
    number: none
    alt: '_'
    lalt: '_'
    sym: '<'
}

key I {
    base: '\u0438'
    capslock+shift: '\u0438'
    shift: '\u0418'
    capslock: '\u0418'
    label: 'I'
    number: '-'
    alt: '-'
    lalt: '-'
    sym: '>'
}

key O {
    base: '\u043e'
    capslock+shift: '\u043e'
    shift: '\u041e'
    capslock: '\u041e'
    label: 'O'
    number: '+'
    alt: '+'
    lalt: '+'
    sym: '^'
}

key P {
    base: '\u043f'
    capslock+shift: '\u043f'
    shift: '\u041f'
    capslock: '\u041f'
    label: 'P'
    number: none
    alt: '@'
    lalt: '@'
    sym: '%'
}

key Q {
    base: '\u0459'
    capslock+shift: '\u0459'
    shift: '\u0409'
    capslock: '\u0409'
    label: 'Q'
    number: '*'
    alt: '*'
    lalt: '*'
    sym: '\u003d'
}

key S {
    base: '\u0441'
    capslock+shift: '\u0441'
    shift: '\u0421'
    capslock: '\u0421'
    label: 'S'
    number: '4'
    alt: '4'
    lalt: '4'
    sym: '\u00F7'
}

key D {
    base: '\u0434'
    capslock+shift: '\u0434'
    shift: '\u0414'
    capslock: '\u0414'
    label: 'D'
    number: '5'
    alt: '5'
    lalt: '5'
    sym: '\u00B1'
}

key F {
    base: '\u0444'
    capslock+shift: '\u0444'
    shift: '\u0424'
    capslock: '\u0424'
    label: 'F'
    number: '6'
    alt: '6'
    lalt: '6'
    sym: '\u2022'
}

key G {
    base: '\u0433'
    capslock+shift: '\u0433'
    shift: '\u0413'
    capslock: '\u0413'
    label: 'G'
    number: '/'
    alt: '/'
    lalt: '/'
    sym: '\\'
}

key H {
    base: '\u0445'
    capslock+shift: '\u0445'
    shift: '\u0425'
    capslock: '\u0425'
    label: 'H'
    number: ':'
    alt: ':'
    lalt: ':'
    sym: '|'
}

key J {
    base: '\u0458'
    capslock+shift: '\u0458'
    shift: '\u0408'
    capslock: '\u0408'
    label: 'J'
    number: ';'
    alt: ';'
    lalt: ';'
    sym: '&'
}

key K {
    base: '\u043a'
    capslock+shift: '\u043a'
    shift: '\u041a'
    capslock: '\u041a'
    label: 'K'
    number: '\''
    alt: '\''
    lalt: '\''
