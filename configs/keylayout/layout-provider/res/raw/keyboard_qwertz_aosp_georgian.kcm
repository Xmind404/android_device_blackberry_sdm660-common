#
# Georgian QWERTY keyboard layout.
# This is a typical Georgian PC keyboard layout.
# As an added convenience, English characters are accessible using ralt (Alt Gr).
#


# Compact BlackBerry adaptation; Copyright (C) 2015 BlackBerry Limited (baseline).
# Language modifiers/currency and physical family are retained.

type OVERLAY


key Q {
    base: '\u10e5'
    label: 'Q'
    number: '#'
    alt: '#'
    lalt: '#'
    sym: '~'
}

key W {
    base: '\u10ec'
    shift: '\u10ed'
    capslock: '\u10ed'
    shift+capslock: '\u10ec'
    label: 'W'
    number: '1'
    alt: '1'
    lalt: '1'
    sym: '`'
}

key E {
    base: '\u10d4'
    label: 'E'
    number: '2'
    alt: '2'
    lalt: '2'
    sym: '{'
}

key R {
    base: '\u10e0'
    shift: '\u10e6'
    capslock: '\u10e6'
    shift+capslock: '\u10e0'
    label: 'R'
    number: '3'
    alt: '3'
    lalt: '3'
    sym: '}'
}

key T {
    base: '\u10e2'
    shift: '\u10d7'
    capslock: '\u10d7'
    shift+capslock: '\u10e2'
    label: 'T'
    number: '('
    alt: '('
    lalt: '('
    sym: '['
}

key Z {
    base: '\u10d6'
    shift: '\u10eb'
    capslock: '\u10eb'
    shift+capslock: '\u10d6'
    label: 'Z'
    number: ')'
    alt: ')'
    lalt: ')'
    sym: '\u005d'
}

key U {
    base: '\u10e3'
    label: 'U'
    number: none
    alt: '_'
    lalt: '_'
    sym: '<'
}

key I {
    base: '\u10d8'
    label: 'I'
    number: '-'
    alt: '-'
    lalt: '-'
    sym: '>'
}

key O {
    base: '\u10dd'
    label: 'O'
    number: '+'
    alt: '+'
    lalt: '+'
    sym: '^'
}

key P {
    base: '\u10de'
    label: 'P'
    number: none
    alt: '@'
    lalt: '@'
    sym: '%'
}

key A {
    base: '\u10d0'
    label: 'A'
    number: '*'
    alt: '*'
    lalt: '*'
    sym: '='
}

key S {
    base: '\u10e1'
    shift: '\u10e8'
    capslock: '\u10e8'
    shift+capslock: '\u10e1'
    label: 'S'
    number: '4'
    alt: '4'
    lalt: '4'
    sym: '\u00F7'
}

key D {
    base: '\u10d3'
    label: 'D'
    number: '5'
    alt: '5'
    lalt: '5'
    sym: '\u00B1'
}

key F {
    base: '\u10e4'
    label: 'F'
    number: '6'
    alt: '6'
    lalt: '6'
    sym: '\u2022'
}

key G {
    base: '\u10d2'
    label: 'G'
    number: '/'
    alt: '/'
    lalt: '/'
    sym: '\\'
}

key H {
    base: '\u10f0'
    label: 'H'
    number: ':'
    alt: ':'
    lalt: ':'
    sym: '|'
}

key J {
    base: '\u10ef'
    shift: '\u10df'
    capslock: '\u10df'
    shift+capslock: '\u10ef'
    label: 'J'
    number: ';'
    alt: ';'
    lalt: ';'
    sym: '&'
}

key K {
    base: '\u10d9'
    label: 'K'
    number: '\''
    alt: '\''
    lalt: '\''
    sym: '\u201C'
}

key L {
    base: '\u10da'
    shift: '\u20be'
    capslock: '\u20be'
    shift+capslock: '\u10da'
    label: 'L'
    number: none
    alt: '\"'
    lalt: '\"'
    sym: '\u201D'
}

key Y {
    base: '\u10e7'
    label: 'Y'
    number: '7'
    alt: '7'
    lalt: '7'
    sym: '\u00a5'
}

key X {
    base: '\u10ee'
    label: 'X'
    number: '8'
    alt: '8'
    lalt: '8'
    sym: '\u20AC'
}

key C {
    base: '\u10ea'
    shift: '\u10e9'
    capslock: '\u10e9'
    shift+capslock: '\u10ea'
    label: 'C'
    number: '9'
    alt: '9'
    lalt: '9'
    sym: '\u00A3'
}

key V {
    base: '\u10d5'
    label: 'V'
    number: none
    alt: '?'
    lalt: '?'
    sym: '\u00BF'
}

key B {
    base: '\u10d1'
    label: 'B'
    number: none
    alt: '!'
    lalt: '!'
    sym: '\u00A1'
}

key N {
    base: '\u10dc'
    label: 'N'
    number: ','
    alt: ','
    lalt: ','
    sym: '\u00AB'
}

key M {
    base: '\u10db'
    label: 'M'
    number: '.'
    alt: '.'
    lalt: '.'
    sym: '\u00BB'
}
